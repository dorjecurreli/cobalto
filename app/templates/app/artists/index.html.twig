{% extends 'base.html.twig' %}

{% block title %}Artists{% endblock %}

{% block body %}

    <!-- Artist List Header -->
    <header class="text-center mt-5">
        <h1>Artists</h1>
    </header>

    <!-- Artist List Section -->
    <section class="mt-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-6">
                    <ul class="list-group list-group-flush">
                        {% for artist in artists|slice(0, (artists|length / 2)|round) %}
                            <li class="list-group-item text-center">
                                <a href="#" class="h5 no-underline">{{ artist.name }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
                <div class="col-12 col-md-6">
                    <ul class="list-group list-group-flush">
                        {% for artist in artists|slice((artists|length / 2)|round) %}
                            <li class="list-group-item text-center">
                                <a href="{{ path('app_artist', {'id': artist.id}) }}" class="h5 no-underline">{{ artist.name }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    {{ include('app/components/footer.html.twig') }}

{% endblock %}
