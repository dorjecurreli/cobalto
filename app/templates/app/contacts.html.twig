{% extends 'base.html.twig' %}

{% block title %}{{ 'app.contacts'|trans }}{% endblock %}

{% block body %}
    <!-- Contact Us Section -->
    <div class="container mt-5">
        <div class="text-center mb-4">
            <h1 class="fw-lighter">{{ 'app.contacts'|trans }}</h1>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="lead">Hai domande, proposte o vuoi collaborare con COBALTO? Contattaci via email. Saremo felici di sentirti!</p>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-md-6">
                <h2 class="fw-normal">Informazioni di Contatto</h2>
                <p><strong>Email:</strong> <a href="mailto:info@cobalto.art">info@cobalto.art</a></p>
                <p><strong>Telefono:</strong> +39 123 456 7890</p>
                <p><strong>Indirizzo:</strong> Via della Creatività, 10 - 00100 Roma, Italia</p>
            </div>
            <div class="col-md-6">
                <h2 class="fw-normal">Scrivici</h2>
                <p>Per contattarci, clicca sul link qui sotto per inviare un'email:</p>
                <a href="mailto:info@cobalto.art" class="btn btn-primary">Invia Email</a>
            </div>
        </div>
    </div>

    {{ include('app/components/footer.html.twig') }}
{% endblock %}
