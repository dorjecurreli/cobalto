{% extends 'base.html.twig' %}

{% block title %}{{ 'app.about-us.title'|trans }}{% endblock %}

{% block body %}
    <!-- About Us Section -->
    <div class="container mt-5">
        <div class="text-center mb-4">
            <h1 class="fw-lighter">{{ 'app.about-us.title'|trans }}</h1>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <p class="lead">{{ 'app.about-us.p-1'|trans }}</p>
            </div>
        </div>

        <div class="row mt-5 align-items-center">
            <div class="col-md-6 text-center">
                <img src="{{ asset('build/images/logo.png') }}" class="img-fluid rounded" alt="About Us Image">
            </div>
            <div class="col-md-6">
                <h2 class="fw-normal">{{ 'app.about-us.vision'|trans }}</h2>
                <p>{{ 'app.about-us.p-2'|trans }}</p>
                <p class="fst-italic">Mauro Bianchi, Gianni Curreli, John Gian</p>
            </div>
        </div>
    </div>

    {{ include('app/components/footer.html.twig') }}
{% endblock %}
